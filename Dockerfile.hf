# Hugging Face Space build: clones the repo instead of using a local build context.
# Generated from Dockerfile (every plain COPY reads from the clone). Set REF to the branch to deploy.
FROM alpine/git AS src
ARG REF=feat/openserp-env-models
# Busts the build cache whenever the branch gets a new commit
ADD https://api.github.com/repos/langtech-bsc/Perplexica/git/refs/heads/${REF} /tmp/ref.json
RUN git clone --depth 1 --branch ${REF} https://github.com/langtech-bsc/Perplexica.git /src

FROM node:24.5.0-slim AS builder

RUN apt-get update && apt-get install -y python3 python3-pip sqlite3 && rm -rf /var/lib/apt/lists/*

WORKDIR /home/vane

COPY --from=src /src/package.json /src/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

COPY --from=src /src/tsconfig.json /src/next.config.mjs /src/next-env.d.ts /src/postcss.config.js /src/drizzle.config.ts /src/tailwind.config.ts ./
COPY --from=src /src/src ./src
COPY --from=src /src/public ./public
COPY --from=src /src/drizzle ./drizzle

RUN mkdir -p /home/vane/data
RUN yarn build

FROM node:24.5.0-slim

RUN apt-get update && apt-get install -y \
    python3-dev python3-babel python3-venv python-is-python3 \
    uwsgi uwsgi-plugin-python3 \
    git build-essential libxslt-dev zlib1g-dev libffi-dev libssl-dev \
    curl sudo \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/vane

COPY --from=builder /home/vane/public ./public
COPY --from=builder /home/vane/.next/static ./public/_next/static
COPY --from=builder /home/vane/.next/standalone ./
COPY --from=src /src/yarn.lock ./
COPY --from=builder /home/vane/data ./data
COPY --from=src /src/drizzle ./drizzle

RUN mkdir /home/vane/uploads

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN yarn add playwright
RUN yarn playwright install --with-deps --only-shell chromium

RUN useradd --shell /bin/bash --system \
    --home-dir "/usr/local/searxng" \
    --comment 'Privacy-respecting metasearch engine' \
    searxng

RUN mkdir "/usr/local/searxng"
RUN mkdir -p /etc/searxng
RUN chown -R "searxng:searxng" "/usr/local/searxng"

COPY --from=src /src/searxng/settings.yml /etc/searxng/settings.yml
COPY --from=src /src/searxng/limiter.toml /etc/searxng/limiter.toml
COPY --from=src /src/searxng/uwsgi.ini /etc/searxng/uwsgi.ini
RUN chown -R searxng:searxng /etc/searxng

USER searxng

RUN git clone "https://github.com/searxng/searxng" \
                   "/usr/local/searxng/searxng-src"

RUN python3 -m venv "/usr/local/searxng/searx-pyenv"
RUN "/usr/local/searxng/searx-pyenv/bin/pip" install --upgrade pip setuptools wheel pyyaml msgspec typing_extensions
RUN cd "/usr/local/searxng/searxng-src" && \
    "/usr/local/searxng/searx-pyenv/bin/pip" install --use-pep517 --no-build-isolation -e .

USER root

WORKDIR /home/vane
COPY --from=src /src/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh
RUN sed -i 's/\r$//' ./entrypoint.sh || true

RUN echo "searxng ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

# Writable paths for non-root runs (e.g. Hugging Face Spaces run as UID 1000)
RUN mkdir -p node_modules/@huggingface/transformers/.cache && \
    chown -R 1000:1000 data uploads node_modules/@huggingface/transformers/.cache

EXPOSE 3000 8080

ENV SEARXNG_API_URL=http://localhost:8080

CMD ["/home/vane/entrypoint.sh"]
